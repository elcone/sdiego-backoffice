# TEMPLATE ONLY. Never load this file as production credentials.
# Install the real file at /etc/sdiego-backoffice/backend.env, root:root 0600.
# systemd EnvironmentFile syntax; never print or source it in an interactive shell.
DJANGO_SETTINGS_MODULE=sdiego_backoffice.settings_production
SECRET_KEY=<REQUIRED_PROTECTED_STABLE_SECRET>
DATABASE_URL=postgresql://sdiego_app:<REQUIRED_URL_ENCODED_PASSWORD>@127.0.0.1:5432/sdiego_backoffice
ALLOWED_HOSTS=privadasandiego.elcone.dev
SECURE_HSTS_SECONDS=<APPROVED_SECONDS>
STATIC_ROOT=/srv/sdiego-backoffice/releases/<RELEASE_ID>/static
MEDIA_ROOT=/srv/sdiego-backoffice/shared/private-media
EMAIL_HOST=<CONFIRMED_SMTP_HOST>
EMAIL_PORT=<CONFIRMED_STARTTLS_PORT>
EMAIL_HOST_USER=<PROTECTED_SMTP_USER>
EMAIL_HOST_PASSWORD=<PROTECTED_SMTP_PASSWORD>
DEFAULT_FROM_EMAIL=<CONFIRMED_SENDER>
# Approved first-deployment policy: no IP-based login limiting.
